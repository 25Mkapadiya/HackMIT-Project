# EIA API v2 — https://www.eia.gov/opendata/register.php (free)
# Used server-side only for nearby generation capacity / balancing authority demand / prices.
EIA_API_KEY=

# FCC Broadband Map API — https://broadbandmap.fcc.gov/ (free, requires account)
# Used server-side only as a retail-broadband connectivity proxy.
FCC_BDC_API_KEY=

# Census Bureau API — https://api.census.gov/data/key_signup.html (free, optional)
# Raises rate limits for ACS population lookups used in the community/population estimate.
CENSUS_API_KEY=

# Supabase — backend database for curated state research (data sources catalog,
# utilities/large-load contacts, existing data centers, incentives, hazards,
# zoning, and persisted scenario proposals + analyses). See supabase/README.md.
# Project URL and anon (publishable) key, both safe to expose client-side —
# access is governed by row-level security, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
