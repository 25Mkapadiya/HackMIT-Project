# EIA API v2 — https://www.eia.gov/opendata/register.php (free)
# Used server-side only for nearby generation capacity / balancing authority demand / prices.
EIA_API_KEY=

# Census Bureau API — https://api.census.gov/data/key_signup.html (free)
# Required (not just rate-limit-raising) by the Census API's own current
# enforcement. Used for the ACS population estimate (land.ts) and, via ACS
# Subject Table S2801, for the "Retail broadband context" fiber/connectivity
# figure (fiber.ts) — a live per-tract broadband-subscription lookup used in
# place of a point query, since the FCC's own Broadband Data Collection API
# only exposes bulk per-state file downloads, not a live lat/lng lookup.
CENSUS_API_KEY=
